<?xml version="1.0"?>
<ruleset name="My Tool Library">
    <description>Coding standards for the My Tool Library plugin.</description>

    <file>my-tool-library</file>

    <exclude-pattern>my-tool-library/documentation/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName"/>

        <!-- This plugin's entire data layer is custom $wpdb tables (members,
             tool_inventory, loans, tool_reservations, etc.); there is no
             WP_Query/WP_User_Query equivalent for them, so direct $wpdb calls
             are unavoidable, not an oversight. Wrapping every read in
             wp_cache_get()/wp_cache_set() would be a real feature addition,
             not a style fix, and risks serving stale data (e.g. showing a
             tool as available right after it was checked out) if cache
             invalidation isn't handled correctly on every insert/update/
             delete path. Deferred as a deliberate, documented tradeoff. -->
        <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
        <exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>

        <!-- The Setup page's "Run Database Setup" button intentionally runs
             CREATE/DROP TABLE statements from the plugin's own bundled
             admin/schema.sql; that IS the feature, gated on
             manage_options plus a nonce, not an accidental schema change. -->
        <exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>

        <!-- mtl_find_wp_user_ids_claiming_member_id() (my-tool-library.php)
             looks up WP users by the mtl_member_id usermeta value via
             get_users(). There is no non-meta way to do this reverse lookup
             through core APIs; moving mtl_member_id into a first-class column
             is a schema change outside the scope of a lint pass. It runs only
             on the admin delete path, to report an account whose link could
             not be verified; the hot path (mtl_current_member()) resolves by
             email against an indexed column instead. -->
        <exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_key"/>
        <exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_value"/>

        <!-- fopen()/fread()/fclose() here are always used on either a
             php://output / php://temp stream (building a CSV/SQL/ZIP file
             for direct download) or an already-validated uploaded tmp file
             (is_uploaded_file() checked first); none of these are real
             filesystem paths WP_Filesystem is designed for, and WP_Filesystem
             has no stream-wrapper equivalent for php://output. -->
        <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_fopen"/>
        <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_fread"/>
        <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_fclose"/>

        <!-- setup-page.php reads the plugin's own bundled admin/schema.sql by
             a hardcoded local path (never a URL or user input) to run Database
             Setup. wp_remote_get() is for HTTP requests and doesn't apply;
             WP_Filesystem() is avoided here since it can prompt for FTP/SSH
             credentials on hosts without direct filesystem access, which
             would turn a one-click admin action into a broken/blocked one. -->
        <exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>

        <!-- Every flagged site is a read-only GET action (catalog search/
             filter/sort/pagination, admin tab highlighting, a status-banner
             lookup); nothing here mutates state, so CSRF protection via a
             nonce does not apply; all real mutations (POST forms) already
             carry and verify a nonce elsewhere in these same files. -->
        <exclude name="WordPress.Security.NonceVerification.Recommended"/>
    </rule>

    <!-- These plugin-defined helpers escape every interpolated value internally
         (see each function's docblock) and are safe to echo directly; this tells
         the EscapeOutput sniff not to flag their call sites. -->
    <rule ref="WordPress.Security.ValidatedSanitizedInput">
        <properties>
            <property name="customSanitizingFunctions" type="array">
                <!-- Runs sanitize_hex_color() and falls back to a known-good
                     colour, so its return is always a valid #rrggbb. -->
                <element value="mtl_color_or_default"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customEscapingFunctions" type="array">
                <!-- Escapes for a CSS context, not an HTML one: it strips every
                     character that could end a declaration or the <style>
                     element. HTML escaping is unsafe to substitute here, since
                     it corrupts quoted font stacks. -->
                <element value="mtl_css_value"/>
                <element value="mtl_format_date"/>
                <element value="mtl_shop_status_badges"/>
                <element value="mtl_shop_pills"/>
                <element value="mtl_lr_detail_html"/>
                <element value="mtl_shop_render_detail_panel"/>
                <element value="mtl_render_shop_page"/>
                <element value="mtl_member_nav_html"/>
                <element value="mtl_front_notice_html"/>
                <element value="mtl_dash_bars"/>
                <element value="mtl_dash_donut"/>
                <element value="mtl_member_page_styles"/>
                <element value="mtl_render_reservation_detail_panel"/>
                <element value="mtl_render_pill_list"/>
                <element value="mtl_markdown_to_html"/>
                <element value="mtl_giving_section_html"/>
            </property>
        </properties>
    </rule>

    <config name="minimum_supported_wp_version" value="5.8"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="my-tool-library"/>
            </property>
        </properties>
    </rule>

    <config name="testVersion" value="7.4-"/>
</ruleset>

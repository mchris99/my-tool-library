<?xml version="1.0"?>
<ruleset name="My Tool Library">
    <description>Coding standards for the My Tool Library plugin.</description>

    <file>my-tool-library</file>

    <exclude-pattern>my-tool-library/documentation/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <config name="minimum_supported_wp_version" value="5.8"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="my-tool-library"/>
            </property>
        </properties>
    </rule>

    <config name="testVersion" value="7.4-"/>
</ruleset>

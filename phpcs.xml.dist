<?xml version="1.0"?>
<ruleset name="My Tool Library">
    <description>Coding standards for the My Tool Library plugin.</description>

    <file>my-tool-library</file>

    <exclude-pattern>my-tool-library/documentation/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <!-- These plugin-defined helpers escape every interpolated value internally
         (see each function's docblock) and are safe to echo directly; this tells
         the EscapeOutput sniff not to flag their call sites. -->
    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customEscapingFunctions" type="array">
                <element value="mtl_format_date"/>
                <element value="mtl_shop_status_badges"/>
                <element value="mtl_shop_pills"/>
                <element value="mtl_lr_detail_html"/>
                <element value="mtl_shop_render_detail_panel"/>
                <element value="mtl_render_shop_page"/>
                <element value="mtl_member_nav_html"/>
                <element value="mtl_front_notice_html"/>
                <element value="mtl_dash_bars"/>
                <element value="mtl_dash_donut"/>
            </property>
        </properties>
    </rule>

    <config name="minimum_supported_wp_version" value="5.8"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="my-tool-library"/>
            </property>
        </properties>
    </rule>

    <config name="testVersion" value="7.4-"/>
</ruleset>

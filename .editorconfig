# Editor defaults for this repo. Line endings match .gitattributes (LF), so
# new files created on Windows don't start out as CRLF. PHP uses tabs, per
# the WordPress coding standard that phpcs.xml.dist applies; the other file
# types keep the spaces they already use.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab

[*.{xml,dist,json,sql}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Block direct HTTP access to the .sql files bundled with this plugin
# (admin/schema.sql, documentation/dummy-data.sql); serving them as plain
# text would disclose the database structure to anyone who guesses the URL.
# Applies to subdirectories too, so this also covers dummy-data.sql. Apache
# only; Nginx-hosted sites need an equivalent rule in their server block.
<FilesMatch "\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
